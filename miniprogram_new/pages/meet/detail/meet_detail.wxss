@import "/style/public/detail.wxss";

.main {
  padding: 0 0 20rpx;
}

.meet-title {
  width: 100%;
  position: relative;
}

.meet-title image {
  width: 100%;
  height: 450rpx;
}

.meet-title .title {
  position: absolute;
  bottom: 20rpx;
  left: 20rpx;
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  text-shadow: 1rpx 1rpx 4rpx rgba(0,0,0,0.5);
}

.meet-title .level {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: #FED202;
  color: #333;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.meet-tab {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.meet-tab .item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
}

.meet-tab .item.cur {
  color: #FED202;
  border-bottom: 4rpx solid #FED202;
}

.date {
  white-space: nowrap;
  padding: 20rpx;
  background: #fff;
}

.date-inner {
  display: inline-block;
  margin-right: 10rpx;
}

.date-inner .item {
  width: 120rpx;
  padding: 15rpx 0;
  text-align: center;
  border-radius: 10rpx;
  background: #f5f5f5;
}

.date-inner .item.cur {
  background: #FED202;
  color: #333;
}

.date-inner .item .status {
  font-size: 22rpx;
}

.date-inner .item .week {
  display: block;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.date-inner .item .day {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
}

.time-title {
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.time {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
}

.time .item {
  width: 30%;
  margin: 0 1.5% 20rpx 1.5%;
  padding: 15rpx 10rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  text-align: center;
}

.time .item.cur {
  background: #FED202;
}

.time .item.selected {
  background: #ddd;
  color: #999;
}

.time .item .t1 {
  display: block;
  font-size: 26rpx;
}

.time .item .t3 {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.1);
}

.bottom .inner {
  padding: 15rpx 20rpx;
}

.bottom .line2 {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.bottom .left {
  font-size: 26rpx;
}

.bottom .right {
  background: #FED202;
  color: #333;
  padding: 15rpx 50rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.day-load {
  padding: 100rpx 0;
}
