@import "/style/public/detail.wxss";

.main {
  padding: 0 20rpx;
}

.qr-box {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.qr-box image {
  width: 300rpx;
  height: 300rpx;
}

.info-box {
  background: #fff;
  border-radius: 10rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.info-box .row {
  display: flex;
  justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}

.info-box .row:last-child {
  border-bottom: none;
}

.info-box .row .label {
  color: #999;
}

.info-box .row .val {
  color: #333;
}
