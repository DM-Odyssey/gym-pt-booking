<view class="container">
  <view class="content-wrapper">
    <text class="title">管理后台</text>

    <view class="input-group">
      <input class="custom-input" maxlength="30" placeholder="请输入管理员账号" placeholder-class="ph" model:value="{{name}}" />
    </view>

    <view class="input-group">
      <input class="custom-input" password maxlength="30" placeholder="请输入管理员密码" placeholder-class="ph" model:value="{{pwd}}" />
    </view>

    <button class="login-btn" bindtap="bindLoginTap">登 录</button>

    <view class="bottom-links">
      <text class="link-text">仅限管理员登录</text>
      <text wx:if="{{showInit}}" class="link-init" bindtap="bindInitTap">首次部署？初始化系统</text>
      <text class="link-back" bindtap="bindBackTap">返回用户端</text>
    </view>
  </view>
</view>
