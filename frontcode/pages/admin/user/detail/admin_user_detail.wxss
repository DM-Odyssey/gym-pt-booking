page { background: #F5F7FA; }

.main-detail {
  width: 100%;
  padding: 24rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 头部卡片 */
.header-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 4px 12px rgba(26,26,46,0.04);
}

.header-avatar {
  width: 96rpx; height: 96rpx;
  border-radius: 50%;
  background: #EFF6FF;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.header-avatar text { font-size: 52rpx; color: #2563EB; }

.header-info { flex: 1; margin-left: 24rpx; }
.header-name { font-size: 36rpx; font-weight: 600; color: #1A1A2E; margin-bottom: 10rpx; }

.tag { font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 12rpx; }
.tag-ok { background: #F0FDF4; color: #22C55E; }
.tag-warn { background: #FFF7ED; color: #F97316; }
.tag-bad { background: #FEF2F2; color: #EF4444; }

/* 信息卡片 */
.info-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4px 12px rgba(26,26,46,0.04);
}

.card-title {
  font-size: 24rpx;
  color: #8C939D;
  padding: 20rpx 24rpx 8rpx;
}

.card-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F5F7FA;
  flex-wrap: wrap;
}
.card-row:last-child { border-bottom: none; }

.row-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #8C939D;
  flex-shrink: 0;
}

.row-value {
  flex: 1;
  font-size: 26rpx;
  color: #1A1A2E;
  word-break: break-all;
}

.row-icon {
  font-size: 28rpx;
  color: #2563EB;
  margin-left: 12rpx;
}

.form-img {
  width: 120rpx; height: 120rpx;
  border-radius: 8rpx;
  margin: 8rpx 8rpx 0 0;
}
