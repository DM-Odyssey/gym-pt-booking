<view wx:if="{{!isLoad}}" class="margin-top load loading text-l text-admin"></view>

<view class="main-admin" wx:if="{{isLoad && isAdmin}}">
  <!-- 头部卡片 -->
  <view class="header-card">
    <view class="header-bar"></view>
    <view class="header-body">
      <view class="header-avatar"><text class="icon-profilefill"></text></view>
      <view class="header-info">
        <view class="header-name">
          <text>{{admin.name}}</text>
          <text wx:if="{{admin.type==1}}" class="badge badge-super">超级管理员</text>
          <text wx:if="{{admin.type==0}}" class="badge badge-normal">管理员</text>
        </view>
        <text class="header-meta">共登录{{admin.cnt}}次，上次{{admin.last}}</text>
      </view>
      <view class="header-exit" bindtap="bindExitTap"><text class="icon-exit"></text></view>
    </view>
  </view>

  <!-- 内容管理 -->
  <view class="menu-section">
    <view class="section-title">内容管理</view>
    <view class="menu-item" bindtap="url" data-url="/pages/admin/user/list/admin_user_list">
      <view class="menu-icon icon-green"><text class="icon-group_fill"></text></view>
      <view class="menu-body"><text class="menu-title">学员管理</text><text class="menu-desc">查看与管理注册学员</text></view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="url" data-url="/pages/admin/news/list/admin_news_list">
      <view class="menu-icon icon-teal"><text class="icon-form"></text></view>
      <view class="menu-body"><text class="menu-title">公告管理</text><text class="menu-desc">发布与编辑公告资讯</text></view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="url" data-url="/pages/admin/meet/list/admin_meet_list">
      <view class="menu-icon icon-blue"><text class="icon-friend"></text></view>
      <view class="menu-body"><text class="menu-title">课程与预约</text><text class="menu-desc">管理课程与预约记录</text></view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 系统设置 -->
  <view class="menu-section">
    <view class="section-title">系统设置</view>
    <view class="menu-item" bindtap="url" data-url="/pages/admin/setup/about/admin_setup_about">
      <view class="menu-icon icon-teal"><text class="icon-edit"></text></view>
      <view class="menu-body"><text class="menu-title">关于我们</text><text class="menu-desc">编辑关于我们页面内容</text></view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="url" data-url="/pages/admin/setup/qrcode/admin_setup_qrcode">
      <view class="menu-icon icon-purple"><text class="icon-qr_code"></text></view>
      <view class="menu-body"><text class="menu-title">小程序码</text><text class="menu-desc">生成与查看小程序二维码</text></view>
      <text class="menu-arrow">›</text>
    </view>
    <view wx:if="{{isSuperAdmin}}" class="menu-item" bindtap="url" data-url="/pages/admin/manager/list/admin_manager_list">
      <view class="menu-icon icon-red"><text class="icon-profile"></text></view>
      <view class="menu-body"><text class="menu-title">管理员管理</text><text class="menu-desc">添加与管理后台账号</text></view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="url" data-url="/pages/admin/manager/password/admin_manager_password">
      <view class="menu-icon icon-orange"><text class="icon-lock"></text></view>
      <view class="menu-body"><text class="menu-title">修改密码</text><text class="menu-desc">更新管理员登录密码</text></view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="url" data-url="/pages/admin/manager/log/admin_log_list">
      <view class="menu-icon icon-brown"><text class="icon-footprint"></text></view>
      <view class="menu-body"><text class="menu-title">操作日志</text><text class="menu-desc">查看管理员操作记录</text></view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出 -->
  <view class="exit-btn" bindtap="bindExitTap">安全退出</view>

  <view style="height: 40rpx;"></view>
</view>
