<view class="main">
  <view class="up">
    <image mode="aspectFill" src="/images/default_index_bg.png" />
  </view>
  <view class="down">
    <view class="menu card-project shadow-project">
      <view bindtap="url" data-url="/pages/meet/list/meet_list?id=1" class="item">
        <view class="item-inner">
          <view class="img shadow">
            <image src="/images/menu/man.png" />
          </view>
          <view class="title">私教预约</view>
        </view>
      </view>

      <view bindtap="url" data-url="/pages/meet/list/meet_list?id=2" class="item">
        <view class="item-inner">
          <view class="img shadow">
            <image src="/images/menu/project.png" />
          </view>
          <view class="title">课程预约</view>
        </view>
      </view>

      <view bindtap="url" data-type="relaunch" data-url="/pages/meet/calendar/meet_calendar" class="item">
        <view class="item-inner">
          <view class="img shadow">
            <image src="/images/menu/day.png" />
          </view>
          <view class="title">课程日历</view>
        </view>
      </view>

    </view>

    <!-- 教练团队 -->
    <view wx:if="{{coachList.length>0}}" class="home-section">
      <view class="home-section-title">教练团队</view>
      <view class="coach-scroll">
        <view class="coach-card" wx:for="{{coachList}}" wx:key="id" bindtap="url" data-url="/pages/meet/detail/meet_detail?id={{item.id}}">
          <image class="coach-avatar" src="{{item.pic}}" mode="aspectFill" />
          <text class="coach-name">{{item.title}}</text>
        </view>
      </view>
    </view>

    <!-- 最新公告 -->
    <view class="home-section">
      <view class="home-section-title">最新公告</view>
      <view wx:if="{{!dataList}}" class="load loading text-l load-project" style="padding:40rpx 0"></view>
      <view wx:else class="home-list-box">
        <import src="/templates/public/base_list_tpl.wxml" />
        <template is="baseListTpl" data="{{dataList,listMode:'leftbig1'}}" />
      </view>
    </view>

    <!-- 推荐课程 -->
    <view wx:if="{{courseList.length>0}}" class="home-section">
      <view class="home-section-title">推荐课程</view>
      <view class="course-list">
        <view class="course-item" wx:for="{{courseList}}" wx:key="id" bindtap="url" data-url="/pages/meet/detail/meet_detail?id={{item.id}}">
          <image class="course-pic" src="{{item.pic}}" mode="aspectFill" />
          <view class="course-info">
            <text class="course-title">{{item.title}}</text>
            <text class="course-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
