<view class="main">
  <view class="top">
    <view class="inner" bindtap="url" data-url="{{user?'/pages/my/edit/my_edit':'/pages/my/register/my_register'}}">
      <view class="avatar">
        <image src="/images/tabbar/my_cur.png" mode="aspectFill"></image>
      </view>
      <view class="right">
        <view class="line1">
          <view class="name">{{user?user.USER_NAME:'注册 / 登录'}}</view>
          <view wx:if="{{user&&user.USER_STATUS==9}}" class="type bg-red">已禁用</view>
          <view wx:elif="{{user&&user.USER_STATUS==0}}" class="type bg-orange">已注册，待审核</view>
          <view wx:elif="{{user&&user.USER_STATUS==8}}" class="type bg-orange">审核未通过，请修改资料</view>
        </view>
        <view class="line2">{{user?'欢迎回来 👋':'加入我们，开启健身之旅'}}</view>
      </view>
    </view>

  </view>

  <!-- 健身卡 -->
  <view wx:if="{{cardLoaded && cards.length>0}}" class="card-section">
    <view class="card-title">我的健身卡</view>
    <view class="card-item" wx:for="{{cards}}" wx:key="id">
      <view class="card-left">
        <view class="card-type {{item.type==1?'type-coach':(item.type==2?'type-course':'type-general')}}">{{item.typeName}}</view>
        <view wx:if="{{item.expire}}" class="card-expire">有效期至 {{item.expire}}</view>
      </view>
      <view class="card-right">
        <view class="card-remain">{{item.remain}}<text class="card-unit">次</text></view>
        <view class="card-total">共 {{item.total}} 次</view>
      </view>
      <view wx:if="{{item.status!=1}}" class="card-badge {{item.status==9?'badge-expire':'badge-done'}}">{{item.statusName}}</view>
    </view>
  </view>
  <view wx:if="{{cardLoaded && cards.length==0}}" class="card-section">
    <view class="card-empty">暂未办卡，请联系健身房</view>
  </view>

  <view class="meet-menu">
    <view class="inner">
      <view class="item" bindtap="url" data-url="/pages/meet/my-joins/meet_my_joins?status=use">
        <view class="img"><image src="/images/my/use.png" /></view>
        <text>已预约</text>
      </view>
      <view class="item" bindtap="url" data-url="/pages/meet/my-joins/meet_my_joins?status=check">
        <view class="img"><image src="/images/my/check.png" /></view>
        <text>已签到</text>
      </view>
      <view class="item" bindtap="url" data-url="/pages/meet/my-joins/meet_my_joins?status=timeout">
        <view class="img"><image src="/images/my/out.png" /></view>
        <text>已过期</text>
      </view>
      <view class="item" bindtap="url" data-url="/pages/meet/my-joins/meet_my_joins?status=cancel">
        <view class="img"><image src="/images/my/cancel.png" /></view>
        <text>已取消</text>
      </view>
      <view class="item" bindtap="url" data-url="/pages/meet/my-joins/meet_my_joins">
        <view class="img"><image src="/images/my/all.png" /></view>
        <text>全部预约</text>
      </view>
    </view>
  </view>

  <view class="list-menu">
    <view class="item" bindtap="url" data-url="/pages/work/login/work_login">
      <view class="title">
        <text class="icon-friend title-ico text-blue"></text>
        <text class="text-project">教练入口</text>
      </view>
    </view>

    <view class="item" bindtap="url" data-url="/pages/about/detail/about_detail?key=SETUP_CONTENT_ABOUT">
      <view class="title">
        <text class="icon-service title-ico"></text>
        <text>关于我们</text>
      </view>
    </view>

    <view class="item" bindtap="bindSetTap">
      <view class="title">
        <text class="icon-settings title-ico"></text>
        <text>设置</text>
      </view>
    </view>
  </view>
  <view style="height:150rpx"></view>
</view>
