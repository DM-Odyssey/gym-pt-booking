<view wx:if="{{isLoad===null}}" class="margin-top load notexist text-l load-project"></view>
<view wx:if="{{isLoad===false}}" class="margin-top load loading text-l load-project"></view>

<view class="main" wx:if="{{isLoad}}">
  <view class="plan-date">
    <cmpt-calendar mode="one" hasDays="{{hasDays}}" bind:click="bindClickCmpt" bind:monthChange="bindMonthChangeCmpt" />
  </view>

  <view class="list">
    <view wx:if="{{list===null}}" class="load loading text-l"></view>
    <text wx:elif="{{list.length==0}}" class="empty-text">今日暂无课程哦~</text>

    <view class="item" wx:for="{{list}}" wx:key="key" bindtap="url" data-url="/pages/meet/detail/meet_detail?id={{item._id}}">
      <image class="item-pic" src="{{item.pic}}" mode="aspectFill" />
      <view class="item-info">
        <text class="item-title">{{item.title}}</text>
        <view class="item-meta">
          <text class="item-tag">{{item.cateName || '课程'}}</text>
          <text class="item-time">{{item.timeDesc}}</text>
        </view>
      </view>
      <text class="item-arrow">›</text>
    </view>
  </view>
</view>

<view style="height: 140rpx;"></view>
