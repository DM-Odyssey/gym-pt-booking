<view wx:if="{{!isLoad}}" class="margin-top load loading text-l load-project"></view>
<block wx:else>
  <wxs src="/templates/wxs/tools.wxs" module="tools" />
  <cmpt-comm-list type="meet-list" _params="{{_params}}" search="{{search||''}}" _menus="{{sortMenus}}" _items="{{sortItems}}" route="meet/list" topBottom="120" isTotalMenu="{{true}}" placeholder="搜索" bind:list="bindCommListCmpt">

    <view class="main">
      <view class="k-list">
        <view bindtap="url" data-url="/pages/meet/detail/meet_detail?id={{item._id}}" class="item shadow-project" wx:for="{{dataList.list}}" wx:key="k">
          <view class="left">
            <image class="loading" lazy-load="{{true}}" mode="aspectFill" src="{{item.MEET_OBJ.cover[0]}}" />
          </view>
          <view class="right">
            <view class="title text-cut">{{item.MEET_TITLE}}</view>
            <view class="desc content-cut-two">{{item.MEET_OBJ.desc}} </view>
            <view class="tag-list">
              <text class="tag" wx:if="{{indx<3}}" wx:for="{{tools.split(item.MEET_OBJ.spec,',')}}" wx:key="k" wx:for-item="itm" wx:for-index="indx">{{itm}}</text>
            </view>
            <view class="line text-cut">
              <view><text class="icon-calendar margin-right-xxs"></text>{{item.openRule}} </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <import src="/templates/public/list_load_tpl.wxml" />
    <template is="listLoadTpl" data="{{skin:'load-project',dataList}}" />
  </cmpt-comm-list>
</block>
