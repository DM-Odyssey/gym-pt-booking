.main {
  width: 100%;
}

.k-list {
  width: 100%;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}

.k-list .item {
  width: 100%;
  display: flex;
  background-color: #fff;
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 10rpx;
  overflow: hidden;
}

.k-list .item .level {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  font-size: 24rpx;
  color: var(--projectColor);
}

.k-list .item .left {
  width: 200rpx;
  height: 200rpx;
  border-radius: 10rpx;
  overflow: hidden;
}

.k-list .item .left image {
  width: 100%;
  height: 100%;
}

.k-list .item .right {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.k-list .item .right .title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.k-list .item .right .desc {
  font-size: 26rpx;
  color: #666;
}

.k-list .item .right .tag-list .tag {
  font-size: 22rpx;
  color: var(--projectColor);
  border: 1rpx solid var(--projectColor);
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  margin-right: 10rpx;
}

.k-list .item .right .line {
  font-size: 24rpx;
  color: #999;
}
