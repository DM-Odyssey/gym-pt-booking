@import "./din.wxss";

.calendar-text { color: var(--calendarMainColor) !important; }
.calendar-bg { background-color: var(--calendarMainColor) !important; }

.cal-container {
  width: 100%;
  padding: 12rpx 0;
  background-color: #fff;
}

.cal-main { width: 100%; padding: 0; }

/* 导航栏 */
.cal-nav {
  position: relative;
  width: 100%;
  height: 64rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0 12rpx;
  box-sizing: border-box;
}

.cal-nav .select-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.cal-nav .nav-arrow {
  width: 56rpx; height: 56rpx;
  display: flex; justify-content: center; align-items: center;
  font-size: 28rpx; color: #8C939D;
}

.cal-nav .nav-label {
  font-size: 30rpx; font-weight: bold; color: #1A1A2E;
}

.cal-nav .fold {
  position: absolute; right: 12rpx;
  font-size: 24rpx; font-weight: normal;
}

.cal-nav .to-now {
  position: absolute; left: 12rpx;
  font-size: 24rpx; font-weight: normal;
  color: var(--calendarMainColor);
}

/* ===== 折叠态：横向日期条 ===== */
.date-strip {
  width: 100%;
  margin-top: 12rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
}

.strip-scroll {
  width: 100%;
  white-space: nowrap;
}

.strip-day {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 80rpx; height: 100rpx;
  border-radius: 16rpx;
  margin-right: 8rpx;
}

.strip-week {
  font-size: 22rpx; color: #8C939D;
  margin-bottom: 6rpx;
}

.strip-date {
  font-size: 30rpx; font-weight: 600; color: #1A1A2E;
}

.strip-day.is-today { background: #F0FDF4; }
.strip-day.is-today .strip-date { color: var(--calendarMainColor); }

.strip-day.is-active { background: var(--calendarMainColor); }
.strip-day.is-active .strip-week,
.strip-day.is-active .strip-date { color: #fff; }

.strip-day.is-other { opacity: 0.3; }

/* 日期条绿点覆盖全局的 ::before 位置 */
.strip-day.data-has::before {
  right: auto;
  top: auto;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
}

/* ===== 展开态：月历 ===== */
.cal-title {
  display: flex; width: 100%;
  margin-top: 8rpx;
  background: transparent;
  border: none;
}

.cal-weekday {
  width: 14.28%; height: 48rpx;
  display: flex; justify-content: center; align-items: center;
  font-size: 22rpx; color: #8C939D;
}

.cal-center {
  display: flex; flex-wrap: wrap;
  justify-content: center; align-items: center;
}

.cal-center .cube {
  width: 14.28%;
  display: flex; justify-content: center; align-items: center;
}

.cal-center .num-grid {
  width: 72rpx; height: 72rpx;
  display: flex; justify-content: center; align-items: center;
  border-radius: 12rpx;
  font-size: 28rpx; color: #1A1A2E;
  font-family: 'din';
}

.cal-center .num-grid.now-day-cur {
  background: var(--calendarMainColor);
  color: #fff; font-weight: 600;
  border-radius: 50%;
}

.cal-center .num {
  display: flex; flex-direction: column;
  justify-content: center; align-items: center;
  font-size: 28rpx;
}

.cal-center .text-no-month { color: #D1D5DB; }

.cal-center .cube.timeout { opacity: 0.3; }

/* 有数据 */
.data-has { position: relative; }
.data-has::before {
  position: absolute; content: '';
  width: 8rpx; height: 8rpx;
  border-radius: 50%;
  background: var(--calendarMainColor);
  right: -12rpx; top: 8rpx;
}

/* 选中日 */
.cube.data-checked .num-grid {
  background: var(--calendarMainColor); color: #fff;
  border-radius: 12rpx;
}
.cube.data-checked .num-grid .text-no-month { color: rgba(255,255,255,0.6); }
.cube.data-checked .data-has::before { background: #fff; }
