.calendar-text { color: var(--calendarMainColor) !important; }
.calendar-bg { background-color: var(--calendarMainColor) !important; }

.cal-container {
  width: 100%;
  padding: 12rpx 0 16rpx;
  background-color: #fff;
  display: flex;
}

.cal-main {
  flex: 1;
  padding: 0 12rpx;
  background: transparent;
}

/* 导航栏 */
.cal-nav {
  position: relative;
  width: 100%;
  height: 64rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #1A1A2E;
  font-size: 30rpx;
  font-weight: bold;
}

.cal-nav .select-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.cal-nav .nav-arrow {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  color: #8C939D;
}

.cal-nav .nav-label {
  font-size: 30rpx;
}

.cal-nav .fold {
  position: absolute;
  right: 4rpx;
  font-size: 24rpx;
  font-weight: 400;
}

.cal-nav .to-now {
  position: absolute;
  left: 4rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--calendarMainColor);
}

/* ===== 折叠态：横向日期条 ===== */
.date-strip {
  width: 100%;
  margin-top: 8rpx;
}

.strip-scroll {
  width: 100%;
  display: flex;
  white-space: nowrap;
}

.strip-day {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 100rpx;
  border-radius: 16rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.strip-week {
  font-size: 22rpx;
  color: #8C939D;
  margin-bottom: 6rpx;
}

.strip-date {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
}

.strip-day.is-today {
  background: #F0FDF4;
}

.strip-day.is-today .strip-date {
  color: var(--calendarMainColor);
}

.strip-day.is-active {
  background: var(--calendarMainColor);
}

.strip-day.is-active .strip-week,
.strip-day.is-active .strip-date {
  color: #fff;
}

.strip-day.is-other {
  opacity: 0.3;
}

/* ===== 展开态：月历 ===== */
.cal-title {
  display: flex;
  justify-content: center;
  margin: 8rpx 0 4rpx;
}

.cal-weekday {
  width: 80rpx;
  height: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 22rpx;
  color: #8C939D;
}

.cal-center {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}

.cal-center .cube {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #1A1A2E;
  border-radius: 12rpx;
}

.cal-center .cube.timeout {
  opacity: 0.3;
}

.cal-center .num-grid {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.cal-center .num-grid.now-day-cur {
  background-color: var(--calendarMainColor);
  height: 60rpx;
  width: 60rpx;
  border-radius: 50%;
  color: #fff;
  font-weight: 600;
}

.cal-center .num-grid.now-day-cur .text-no-month {
  color: #fff;
}

.cal-center .num {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
}

.cal-center .text-no-month {
  color: #D1D5DB;
}

/* 有数据圆点 */
.data-has { position: relative; }
.data-has::before {
  position: absolute;
  content: '';
  right: 10rpx;
  bottom: 6rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--calendarMainColor);
}

/* 选中日 */
.cube.data-checked {
  background: var(--calendarMainColor) !important;
  color: #fff !important;
}
.cube.data-checked .text-no-month { color: rgba(255,255,255,0.6) !important; }
.cube.data-checked.data-has::before { background: #fff; }
