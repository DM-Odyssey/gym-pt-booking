<wxs src="../../../../templates/wxs/tools.wxs" module="tools" />
<wxs module="utils">
  function compareYearMonth(oneDoDay, year, month) {
    var arr = oneDoDay.split('-');
    return arr[0] == year && arr[1] == month;
  }
  module.exports = { compareYearMonth: compareYearMonth };
</wxs>

<view class="cal-container">
  <view class="cal-main">
    <!-- 导航栏 -->
    <view class="cal-nav">
      <view class="to-now" bindtap="bindToNowTap">本月</view>
      <view class="select-item">
        <view class="nav-arrow" bindtap="bindLastTap"><text class="icon-back"></text></view>
        <view class="nav-label">{{year}}年{{month}}月</view>
        <view class="nav-arrow" bindtap="bindNextTap"><text class="icon-right"></text></view>
      </view>
      <view class="fold" bindtap="bindFoldTap">
        <text class="calendar-text">{{fold ? '展开' : '收起'}}</text>
      </view>
    </view>

    <!-- 折叠态：横向日期条（10天） -->
    <view wx:if="{{fold}}" class="date-strip">
      <scroll-view scroll-x class="strip-scroll" enhanced show-scrollbar="{{false}}">
        <view class="strip-day {{item.full==fullToday?'is-today':''}} {{item.full==oneDoDay?'is-active':''}} {{!item.curMonth?'is-other':''}}"
              wx:for="{{dayArr}}" wx:key="key"
              bindtap="bindDayOneTap" data-fullday="{{item.full}}">
          <text class="strip-week">{{item.week}}</text>
          <text class="strip-date">{{item.show}}</text>
        </view>
      </scroll-view>
    </view>

    <!-- 展开态：完整月历 -->
    <block wx:if="{{!fold}}">
      <view class="cal-title">
        <view class="cal-weekday">一</view>
        <view class="cal-weekday">二</view>
        <view class="cal-weekday">三</view>
        <view class="cal-weekday">四</view>
        <view class="cal-weekday">五</view>
        <view class="cal-weekday">六</view>
        <view class="cal-weekday">日</view>
      </view>

      <view class="cal-center">
        <view wx:for="{{dayArr}}" wx:key="key" data-fullday="{{item.full}}"
              class="cube {{item.full<fullToday?'timeout':''}} {{tools.includes(hasDays,item.full)?'data-has':''}} {{tools.includes(hasJoinDays,item.full)?'join-has':''}} {{item.full==oneDoDay?'data-checked':''}}"
              bindtap="bindDayOneTap">
          <view class="num-grid {{fullToday==item.full?'now-day-cur':''}}">
            <view class="num {{!item.curMonth?'text-no-month':''}}">
              <text class="dd">{{item.show}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
